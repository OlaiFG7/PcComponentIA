        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The firmware is validating a configured BIOS or boot password."
          }
        }
      }
    },
    "El firmware ha detectado memoria instalada y continúa con la inicialización posterior." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The firmware has detected installed memory and is continuing with later initialisation."
