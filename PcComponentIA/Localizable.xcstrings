      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It only indicates a problem if it stays stuck."
          }
        }
      }
    },
    "Solo investígalo como fallo si el código no progresa." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only investigate it as a fault if the code doesn't progress."
          }
        }
      }
    },
    "Solo se considera incidencia si queda bloqueado." : {
