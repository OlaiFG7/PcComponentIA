    "Cabecera ARGB direccionable de 5 V y tres pines integrada en la placa base. Permite controlar LEDs individuales en accesorios compatibles." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5 V three-pin addressable ARGB header built into the motherboard. It controls individual LEDs on compatible accessories."
          }
        }
      }
    },
    "Cabecera F_PANEL o JFP1 integrada en la placa base para los cables del botón de encendido, reset y LEDs del frontal de la caja." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "F_PANEL or JFP1 header built into the motherboard for the case's power button, reset button and front LED cables."
          }
        }
      }
    },
    "Cabecera interna de audio integrada en la placa base para los conectores de auriculares y micrófono del frontal de la caja." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Internal audio header built into the motherboard for the headphone and microphone jacks on the front of the case."
          }
        }
      }
    },
    "Cabecera interna Type-E integrada en algunas placas para el puerto USB-C frontal de la caja." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Internal Type-E header found on some motherboards for the case's front USB-C port."
          }
        }
      }
    },
    "Cabecera RGB analógica de 12 V y cuatro pines integrada en la placa base. Todos los LEDs conectados muestran el mismo color al mismo tiempo." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12 V four-pin analogue RGB header built into the motherboard. All connected LEDs show the same colour at the same time."
          }
        }
      }
    },
    "Cabecera USB 2.0 interna integrada en la placa base. Puede servir a puertos frontales, controladores RGB, AIO y otros accesorios." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Internal USB 2.0 header built into the motherboard. It can serve front ports, RGB controllers, AIOs and other accessories."
          }
        }
      }
    },
    "Cabecera USB 3.x interna de 19 o 20 pines integrada en la placa base para los puertos USB-A frontales de la caja." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "19- or 20-pin internal USB 3.x header built into the motherboard for the case's front USB-A ports."
          }
        }
      }
    },
    "Cabezal de 3 o 4 pines integrado en la placa base para el ventilador principal del disipador de CPU. Permite a la BIOS supervisar y regular su velocidad." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3- or 4-pin header built into the motherboard for the CPU cooler's main fan. It lets the BIOS monitor and control its speed."
          }
        }
      }
    },
    "Cabezal de 3 pines para iluminación direccionable. No lo confundas con RGB 12 V." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3-pin header for addressable lighting. Don't confuse it with 12 V RGB."
          }
        }
      }
    },
    "Cabezal de 4 pines para el ventilador del disipador de la CPU." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4-pin header for the CPU cooler fan."
          }
        }
      }
    },
    "Cabezal de 4 pines para ventiladores de la caja." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4-pin header for case fans."
          }
        }
      }
    },
    "Cabezal de 9 pines para los USB 2.0 del frontal." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "9-pin header for the front USB 2.0 ports."
          }
        }
      }
    },
