        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ASRock recommends reinstalling the VGA and trying another slot if it persists."
          }
        }
      }
    },
    "ASUS agrupa 53 y 55 como incidencias habituales de memoria." : {
      "extractionState" : "manual",
