        }
      }
    },
    "Si tu placa tiene BIOS Flashback, reinstala la BIOS desde un USB." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If your motherboard has BIOS Flashback, reinstall the BIOS from a USB drive."
