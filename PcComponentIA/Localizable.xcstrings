    },
    "Si falla, comprobar unidad de arranque" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If it fails, check the boot drive"
          }
        }
      }
    },
    "Si hay imagen y el sistema arranca, no hay que hacer nada." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If there's a picture and the system boots, there's nothing to do."
          }
        }
      }
    },
    "Si no hay imagen, revisar cable y entrada del monitor" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If there's no picture, check the cable and monitor input"
          }
        }
      }
    },
    "Si no hay imagen, revisar monitor y GPU" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If there's no picture, check the monitor and GPU"
          }
        }
      }
    },
    "Si persiste, la placa base puede estar dañada." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If it persists, the motherboard may be damaged."
          }
        }
      }
    },
    "Si persiste, puede ser la placa base." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If it persists, it may be the motherboard."
          }
        }
      }
    },
    "Si queda fijo, desconectar USB y PCIe no esenciales" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If it stays stuck, unplug non-essential USB and PCIe devices"
          }
        }
      }
    },
    "Si se bloquea, forzar apagado manteniendo el botón" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If it hangs, force a shutdown by holding the button"
          }
        }
      }
    },
    "Si se bloquea, probar la RAM en A2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If it hangs, test the RAM in A2"
          }
        }
      }
    },
    "Si se bloquea, realizar Clear CMOS" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If it hangs, clear the CMOS"
          }
        }
      }
    },
    "Si se queda fijo y no hay imagen, centra las pruebas en la GPU." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If it stays stuck with no picture, focus your tests on the GPU."
          }
        }
      }
    },
    "Si se queda fijo, la RAM o su contacto es la primera comprobación." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If it stays stuck, the RAM or its contact is the first thing to check."
          }
        }
      }
    },
    "Si se repite cada vez que apagas, cambia la pila CMOS (CR2032)." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If it happens every time you power off, replace the CMOS battery (CR2032)."
          }
        }
      }
    },
    "Si tienes GPU dedicada, conecta el monitor a la GPU y no a los puertos de vídeo de la placa base." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you have a dedicated GPU, connect the monitor to the GPU, not to the motherboard's video ports."
          }
        }
      }
    },
    "Si tienes otro módulo, pruébalo para descartar uno defectuoso." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you have another module, try it to rule out a faulty one."
          }
        }
      }
    },
    "Si tu placa tiene BIOS Flashback o Dual BIOS, recupérala desde ahí." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If your motherboard has BIOS Flashback or Dual BIOS, recover it from there."
