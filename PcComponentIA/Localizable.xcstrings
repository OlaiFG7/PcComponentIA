    "El firmware está preparando los componentes del chipset antes de inicializar la memoria." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The firmware is preparing the chipset components before initialising the memory."
