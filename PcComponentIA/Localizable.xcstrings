    "Solo aplica cuando el fallo ocurre al despertar el equipo." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It only applies when the failure happens on waking the computer."
          }
        }
      }
    },
    "Solo diagnosticarlo como fallo si queda fijo." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only treat it as a fault if it stays stuck."
          }
        }
      }
    },
    "Solo es relevante si el equipo no avanza nunca desde este código." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It only matters if the computer never moves on from this code."
          }
        }
      }
    },
    "Solo indica una incidencia si se queda detenido de forma persistente." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It only indicates a problem if it stays stuck."
          }
        }
