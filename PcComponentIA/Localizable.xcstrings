    "Es habitual al montar una CPU más nueva con una BIOS antigua." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It's common when fitting a newer CPU with an old BIOS."
          }
        }
      }
    },
    "Es habitual después de un Clear CMOS o actualización de BIOS." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It's common after a CMOS clear or BIOS update."
